<UserControl x:Class="LanguageLearningApp.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        
        <Grid HorizontalAlignment="Center" Margin="0,24,0,12">
            <TextBlock Text="MENU GŁÓWNE" FontSize="56" FontWeight="Bold"
                       Foreground="#07152A" Opacity="0.28"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <TranslateTransform X="8" Y="8"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock Text="MENU GŁÓWNE" FontSize="56" FontWeight="Bold"
                       Foreground="#0B2340" Opacity="0.18"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <TranslateTransform X="4" Y="4"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock Text="MENU GŁÓWNE" FontSize="56" FontWeight="Bold"
                       RenderOptions.ClearTypeHint="Enabled" SnapsToDevicePixels="True">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#EAF4FF" Offset="0.35"/>
                        <GradientStop Color="#9FBFF8" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FFFFFF" Direction="270" ShadowDepth="1" BlurRadius="2" Opacity="0.6"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="MENU GŁÓWNE" FontSize="56" FontWeight="Bold"
                       Foreground="#07152A" Opacity="0.24">
                <TextBlock.RenderTransform>
                    <TranslateTransform X="2" Y="2"/>
                </TextBlock.RenderTransform>
                <TextBlock.Effect>
                    <BlurEffect Radius="3"/>
                </TextBlock.Effect>
            </TextBlock>
        </Grid>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <Button Content="Zestawy słówek" Click="Sets_Click" Margin="10" Width="200"/>
            <Button Content="Gry" Click="Games_Click" Margin="10" Width="200"/>

        </StackPanel>
    </Grid>
</UserControl>