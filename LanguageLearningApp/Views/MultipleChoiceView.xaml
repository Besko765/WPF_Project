<UserControl x:Class="LanguageLearningApp.Views.MultipleChoiceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="⬅ Powrót" Click="Back_Click"/>
            <TextBlock Text="Quiz - wielokrotny wybór" FontSize="18" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock Text="Wybierz zestaw:"/>
            <ComboBox x:Name="SetSelector" DisplayMemberPath="Name" Width="250" Margin="0,8,0,12" SelectionChanged="SetSelector_SelectionChanged"/>

            <Border Padding="12" Background="#FFF" CornerRadius="6">
                <StackPanel Width="420" HorizontalAlignment="Center">
                    <TextBlock x:Name="QuestionText" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8"/>
                    <StackPanel x:Name="OptionsPanel" Margin="0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="Następne" Click="Next_Click" Width="120" Margin="4"/>
                    </StackPanel>
                    <TextBlock x:Name="ResultMessage" Margin="0,12,0,0" FontWeight="Bold" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>