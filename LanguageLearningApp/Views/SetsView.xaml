<UserControl x:Class="LanguageLearningApp.Views.SetsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="⬅ Powrót"
                Click="Back_Click"
                Margin="10"
                Width="120"/>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 3D nagłówek: Lista zestawów -->
                <Grid HorizontalAlignment="Center" Margin="0,24,0,12">
                    <TextBlock Text="Lista zestawów" FontSize="36" FontWeight="Bold"
                               Foreground="#07152A" Opacity="0.28"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="6" Y="6"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <TextBlock Text="Lista zestawów" FontSize="36" FontWeight="Bold"
                               Foreground="#0B2340" Opacity="0.18"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="3" Y="3"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <TextBlock Text="Lista zestawów" FontSize="36" FontWeight="Bold"
                               RenderOptions.ClearTypeHint="Enabled" SnapsToDevicePixels="True">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#EAF4FF" Offset="0.35"/>
                                <GradientStop Color="#9FBFF8" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFFFFF" Direction="270" ShadowDepth="1" BlurRadius="2" Opacity="0.6"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock Text="Lista zestawów" FontSize="36" FontWeight="Bold"
                               Foreground="#07152A" Opacity="0.24">
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="1.5" Y="1.5"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Effect>
                            <BlurEffect Radius="2.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>

                <ListBox Grid.Row="1"
                         x:Name="SetsList"
                         ItemsSource="{Binding Sets}"
                         SelectedItem="{Binding SelectedSet, Mode=TwoWay}"
                         Margin="10"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Margin="5"/>
                                <TextBlock Text=" ("/>
                                <TextBlock Text="{Binding OgLanguage}"/>
                                <TextBlock Text=" → "/>
                                <TextBlock Text="{Binding NewLanguage}"/>
                                <TextBlock Text=")"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <StackPanel Grid.Column="1" Margin="10">

                <TextBlock Text="Dodaj / Edytuj zestaw" FontSize="18" Margin="5"/>

                <TextBlock Text="Nazwa zestawu"/>
                <TextBox Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Text="Język źródłowy"/>
                <TextBox Text="{Binding OgLangInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Text="Język docelowy"/>
                <TextBox Text="{Binding NewLangInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,0">
                    <!-- Dodano Click fallback obok Command -->
                    <Button Content="Dodaj" Command="{Binding AddCommand}" Click="AddSet_Click" Margin="0,0,8,0"/>
                    <Button Content="Zaktualizuj" Command="{Binding UpdateCommand}" Margin="0,0,8,0"/>
                    <Button Content="Usuń" Command="{Binding DeleteCommand}" Margin="0,0,8,0"/>
                    <Button Content="Wyczyść" Command="{Binding ClearCommand}" Margin="0,0,8,0"/>
                    <Button Content="Otwórz" Click="OpenSet_Click" />
                </StackPanel>

            </StackPanel>

            <!-- Sekcja zarządzania słówkami przeniesiona do osobnego widoku SetEditorView -->
        </Grid>
    </Grid>
</UserControl>