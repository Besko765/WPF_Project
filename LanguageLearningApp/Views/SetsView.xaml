<UserControl x:Class="LanguageLearningApp.Views.SetsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="⬅ Powrót"
                Click="Back_Click"
                Margin="10"
                Width="120"/>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Lista zestawów" FontSize="20" Margin="10"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,6">
                    <TextBox x:Name="NameFilter" Width="200" ToolTip="Filtruj..." TextChanged="NameFilter_TextChanged"/>
                    <TextBlock Text="(dwuklik otwiera edycję)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
                </StackPanel>

                <ListBox Grid.Row="2"
                         x:Name="SetsList"
                         ItemsSource="{Binding Sets}"
                         SelectedItem="{Binding SelectedSet, Mode=TwoWay}"
                         Margin="10"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         MouseDoubleClick="SetsList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Margin="5"/>
                                <TextBlock Text=" ("/>
                                <TextBlock Text="{Binding OgLanguage}"/>
                                <TextBlock Text=" → "/>
                                <TextBlock Text="{Binding NewLanguage}"/>
                                <TextBlock Text=")"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <StackPanel Grid.Column="1" Margin="10">

                <TextBlock Text="Dodaj / Edytuj zestaw" FontSize="18" Margin="5"/>

                <TextBlock Text="Nazwa zestawu"/>
                <TextBox Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Text="Język źródłowy"/>
                <TextBox Text="{Binding OgLangInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <TextBlock Text="Język docelowy"/>
                <TextBox Text="{Binding NewLangInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,0">
                    <!-- Nowy otwiera okno edycji dla nowego zestawu -->
                    <Button Content="Nowy" Click="AddSet_Click" Margin="0,0,8,0"/>
                    <!-- Edytuj otwiera okno edycji dla zaznaczonego zestawu -->
                    <Button Content="Edytuj" Click="EditSet_Click" Margin="0,0,8,0"/>
                    <Button Content="Usuń" Command="{Binding DeleteCommand}" Margin="0,0,8,0"/>
                    <Button Content="Wyczyść" Command="{Binding ClearCommand}" Margin="0,0,8,0"/>
                    <Button Content="Otwórz (edytor)" Click="OpenSet_Click" />
                </StackPanel>

            </StackPanel>

            <!-- Sekcja zarządzania słówkami przeniesiona do okna SetEditorWindow dla lepszej ergonomii -->
        </Grid>
    </Grid>
</UserControl>