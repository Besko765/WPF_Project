<UserControl x:Class="LanguageLearningApp.Views.SetsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔙 PRZYCISK POWROTU -->
        <Button Content="⬅ Powrót"
                Click="Back_Click"
                Margin="10"
                Width="120"/>

        <!-- 🔽 GŁÓWNA ZAWARTOŚĆ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 🔹 LISTA -->
            <StackPanel Grid.Column="0">

                <TextBlock Text="Lista zestawów" FontSize="20" Margin="10"/>

                <ListBox x:Name="SetsList" Margin="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Margin="5"/>
                                <TextBlock Text=" ("/>
                                <TextBlock Text="{Binding OgLanguage}"/>
                                <TextBlock Text=" → "/>
                                <TextBlock Text="{Binding NewLanguage}"/>
                                <TextBlock Text=")"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </StackPanel>

            <!-- 🔹 FORMULARZ -->
            <StackPanel Grid.Column="1" Margin="10">

                <TextBlock Text="Dodaj zestaw" FontSize="18" Margin="5"/>

                <TextBlock Text="Nazwa zestawu"/>
                <TextBox x:Name="NameInput" Margin="0,0,0,10"/>

                <TextBlock Text="Język źródłowy"/>
                <TextBox x:Name="OgLangInput" Margin="0,0,0,10"/>

                <TextBlock Text="Język docelowy"/>
                <TextBox x:Name="NewLangInput" Margin="0,0,0,10"/>

                <Button Content="Dodaj"
                        Click="AddSet_Click"
                        Margin="5"/>

            </StackPanel>

        </Grid>
    </Grid>
</UserControl>