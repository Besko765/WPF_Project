<UserControl x:Class="LanguageLearningApp.Views.SetEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="⬅ Powrót" Click="Back_Click"/>
            <TextBlock Text="Edytuj zestaw" FontSize="18" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Nazwa zestawu"/>
                <TextBlock x:Name="SetName" FontWeight="Bold" FontSize="16" Margin="0,4,0,8"/>

                <TextBlock Text="Lista słów" FontWeight="Bold"/>
                <ListBox x:Name="WordsList" DisplayMemberPath="Text" Height="200"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="8">
                <TextBlock Text="Tekst (źródłowy)"/>
                <TextBox x:Name="WordText" Margin="0,0,0,8"/>
                <TextBlock Text="Tłumaczenie"/>
                <TextBox x:Name="WordTranslation" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Dodaj" Click="Add_Click" Margin="0,0,8,0"/>
                    <Button Content="Aktualizuj" Click="Update_Click" Margin="0,0,8,0"/>
                    <Button Content="Usuń" Click="Delete_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
