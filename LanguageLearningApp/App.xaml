<Application x:Class="LanguageLearningApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Możesz dodać inne słowniki tutaj -->
            </ResourceDictionary.MergedDictionaries>

            <!-- FontFamily resources -->
            <!-- Używamy systemowego fontu najbardziej zbliżonego do estetyki Frutiger: Segoe UI -->
            <FontFamily x:Key="AppFrutiger">Segoe UI</FontFamily>

            <!-- Domyślny font aplikacji dla kontrolek -->
            <Style TargetType="Control">
                <Setter Property="FontFamily" Value="{StaticResource AppFrutiger}" />
            </Style>

            <!-- Header pill style (wygląd jak button, ale nie interaktywny) -->
            <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F7FAFC" Offset="0" />
                <GradientStop Color="#EEF3F8" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="HeaderPillLabelStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource AppFrutiger}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#0F1720" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Margin" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Label">
                            <Border Background="{StaticResource HeaderBackgroundBrush}"
                                    BorderBrush="#DDE6EE"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rozmiary tekstu -->
            <sys:Double x:Key="FontSizeTitle">18</sys:Double>
            <sys:Double x:Key="FontSizeBody">14</sys:Double>

            <!-- Style dla tekstów -->
            <Style TargetType="TextBlock" x:Key="TitleTextBlock">
                <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#0F1720" />
            </Style>

            <!-- Implicitny styl TextBlock — nadpisuje wszystkie TextBlocki (opcja B) -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFrutiger}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="#1F2933" />
            </Style>

            <!-- Globalny styl przycisków: Frutiger Aero z cieniowaniem -->
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource AppFrutiger}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#1F2933" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Margin" Value="6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F7FAFC" Offset="0" />
                            <GradientStop Color="#EEF3F8" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="#DDE6EE" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <!-- lekki, domyślny cień -->
                                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.04"/>
                                </Border.Effect>

                                <Grid>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True" />
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#F1F6FA" Offset="0" />
                                                <GradientStop Color="#E6EEF5" Offset="1" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>

                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#C7D7E6" />
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <!-- mocniejszy cień na hover -->
                                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.12"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#E9F0F6" Offset="0" />
                                                <GradientStop Color="#DCE7F0" Offset="1" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Bd" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="1" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <!-- przyciski wciśnięte: cień minimalny -->
                                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.06"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="#0F1720"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Styl dla nagłówków sekcji (HeaderPill) -->
            <Style x:Key="HeaderPillStyle" TargetType="Border">
                <Setter Property="Background" Value="#E1F5FE" />
                <Setter Property="BorderBrush" Value="#B2EBF2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
